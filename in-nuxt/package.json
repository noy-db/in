{
  "name": "@noy-db/in-nuxt",
  "version": "0.9.0-pre.0",
  "description": "Nuxt 4 module for noy-db — auto-imports, SSR-safe runtime plugin, and the @noy-db/in-pinia bridge",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/in/tree/main/in-nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/in.git",
    "directory": "in-nuxt"
  },
  "bugs": {
    "url": "https://github.com/noy-db/in/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.8.0 || ^0.9.0-pre.1",
    "@noy-db/in-pinia": "workspace:^",
    "@noy-db/in-rest": "^0.8.0 || ^0.9.0-pre.1",
    "@noy-db/in-vue": "workspace:^",
    "nuxt": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@noy-db/in-rest": {
      "optional": true
    }
  },
  "dependencies": {
    "@noy-db/in-devtools": "0.9.0-pre.2"
  },
  "devDependencies": {
    "@noy-db/hub": "0.9.0-pre.2",
    "@noy-db/in-pinia": "workspace:*",
    "@noy-db/in-rest": "0.9.0-pre.2",
    "@noy-db/in-vue": "workspace:*",
    "@noy-db/to-browser-idb": "0.9.0-pre.2",
    "@noy-db/to-meter": "0.9.0-pre.2",
    "@nuxt/kit": "^4.4.2",
    "@nuxt/schema": "^4.4.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "h3": "^1.13.0",
    "happy-dom": "^18.0.0",
    "nuxt": "^4.4.2",
    "vue": "^3.5.32"
  },
  "keywords": [
    "noy-db",
    "nuxt",
    "nuxt4",
    "module",
    "encryption",
    "zero-knowledge",
    "offline-first",
    "pinia",
    "vue"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
